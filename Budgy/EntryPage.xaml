<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Budgy.EntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}"
    Appearing="ContentPage_Appearing">
    <Grid>
        <VerticalStackLayout Padding="12" Spacing="12">
            <Entry Placeholder="Titel" Text="{Binding Title}" />
            <Entry
                Keyboard="Numeric"
                Placeholder="Betrag"
                Text="{Binding Amount}" />
            <Grid ColumnDefinitions="*, Auto">
                <Label
                    Grid.Column="0"
                    Text="Bezahl Datum"
                    VerticalTextAlignment="Center" />
                <DatePicker Grid.Column="1" Date="{Binding PayDate}" />
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="{Binding ExpenseText}" />
                <Switch Grid.Column="1" IsToggled="{Binding IsExpense}" />
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
                <Picker
                    Title="Kategorie"
                    Grid.Column="0"
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}" />
                <ImageButton
                    Grid.Column="1"
                    Command="{Binding ClearSelectedCategoryCommand}"
                    Source="delete_white.png" />
            </Grid>
            <Editor AutoSize="TextChanges" Text="{Binding Description}" />
        </VerticalStackLayout>
        <Button
            Margin="0,0,0,100"
            Command="{Binding SaveCommand}"
            CornerRadius="40"
            HeightRequest="80"
            ImageSource="add_white.png"
            VerticalOptions="End"
            WidthRequest="80" />
    </Grid>
</ContentPage>