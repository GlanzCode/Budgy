<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Budgy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Budgy"
    Title="Budgy">

    <TabBar>
        <Tab Title="Home" Icon="home_filled.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Einstellungen" Icon="settings_filled.png">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" Route="SettingsPage" />
        </Tab>
    </TabBar>

</Shell>
