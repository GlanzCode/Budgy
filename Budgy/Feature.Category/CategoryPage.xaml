<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Budgy.Feature.Category.CategoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="CategoryPage"
    Shell.PresentationMode="ModalAnimated">
    <Grid RowDefinitions="*">
        <VerticalStackLayout
            Grid.Row="0"
            Padding="12"
            Spacing="12">
            <Entry Placeholder="Name" Text="{Binding Name}" />
            <Grid ColumnDefinitions="*, Auto">
                <Label
                    Grid.Column="0"
                    Text="Farbe"
                    VerticalTextAlignment="Center" />
                <Border
                    Grid.Column="1"
                    BackgroundColor="{Binding ColorHex}"
                    HeightRequest="50"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    WidthRequest="200">
                    <Label
                        HorizontalOptions="Center"
                        Text="Wählen"
                        VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectedColorCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </VerticalStackLayout>
        <Button
            Margin="0,0,0,100"
            Command="{Binding SaveCommand}"
            CornerRadius="40"
            HeightRequest="80"
            ImageSource="add_white.png"
            VerticalOptions="End"
            WidthRequest="80" />
    </Grid>
</ContentPage>