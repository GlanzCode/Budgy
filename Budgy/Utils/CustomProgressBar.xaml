<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Budgy.CustomProgressBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="this">

    <Border
        BackgroundColor="{Binding BackgroundColor, Source={x:Reference this}}"
        HeightRequest="{Binding HeightRequest, Source={x:Reference this}}"
        Stroke="Transparent"
        StrokeThickness="0">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference this}}" />
        </Border.StrokeShape>

        <Grid x:Name="ProgressBarGrid" IsClippedToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="0.*" />
                <ColumnDefinition x:Name="RightColumn" Width="1.*" />
            </Grid.ColumnDefinitions>

            <BoxView
                Grid.Column="0"
                BackgroundColor="{Binding ProgressColor, Source={x:Reference this}}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <BoxView
                Grid.Column="1"
                BackgroundColor="SlateGray"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />
        </Grid>
    </Border>
</ContentView>
